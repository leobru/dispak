шифр 419999 зс5^
лен 41(2048)^
eeв1а3
*name pz subtasks
*no list
*assembler
C Form a normal subtask, then exercise the master-side controls backed by
C tasks.c's shared registry slot: stop/start, events, terminal transfer,
C task listing, hide/event-mask fields, and stream retrieval after exit.
 program: ,name,
C Enable event bits for alarm and "ПЗ appeared", then form the child from
C the in-memory deck below with E50 7701.
	  ,xta , mask
	  ,*53 , 12b
	 15,vtm, cwrd
	  ,ita , 15
	  ,*50 , 7701b
C Save the child stream request word.  R14 holds the input catalog number.
	  ,ita , 14
	  ,asn , 50b
	  ,aox , strq
	  ,atx , sreq
C Wait until the subtask has declared this task as master and appealed.
 wexp:	  ,*53 , 17b
	  ,*53 , 16b
	  ,aax , b11
	  ,uza , wexp
C Stop the child, resolve its program channel, and fetch/clear its events.
	  ,xta , pzc
	  ,*53 , 30b
	  ,atx , res
	  ,*64 , inf64
	  ,xta , pzc
	  ,*50 , 206b
	  ,atx , res
	  ,*64 , inf64
	  ,xta , pzc
	  ,*53 , 36b
	  ,atx , res
	  ,*64 , inf64
C Raise event bit 2 in the child, then verify it is visible in E53 36.
	 13,vtm, evw
	  ,xta , pzc
	  ,*53 , 32b
	  ,atx , res
	  ,*64 , inf64
	  ,xta , pzc
	  ,*53 , 36b
	  ,atx , res
	  ,*64 , inf64
C Query stop cause and stopped-subtask scale for the parked child.
	  ,xta , pzc
	  ,*62 , 54b
	  ,atx , res
	  ,*64 , inf64
	  ,xta ,
	  ,*62 , 101b
	  ,atx , res
	  ,*64 , inf64
C E62 61 lists subordinate task шифры into BUFA and returns the low-half
C subordinate channel scale.
	 13,vtm, bufa
	  ,xta ,
	  ,*62 , 61b
	  ,atx , res
	  ,*64 , inf64
	  ,*64 , infb
C E62 63 sets the hidden-area address for the master.
	 13,vtm, res
	  ,xta , pzc
	  ,*62 , 63b
	  ,atx , res
	  ,*64 , inf64
C E62 64 sets the event mask the master records for this child.
	 13,vtm, evw
	  ,xta , pzc
	  ,*62 , 64b
	  ,atx , res
	  ,*64 , inf64
C Resume the child by its invented channel number.
	  ,xta , exec2
	  ,*53 , 31b
	  ,atx , res
	  ,*64 , inf64
C Wait for the child to disappear, then retrieve its print stream.
 wend:	  ,*53 , 17b
	  ,xta , pzc
	  ,*50 , 206b
	  ,aox ,
	  ,u1a , wend
	  ,xta , sreq
	  ,*62 , 41b
	  ,atx , res
	  ,*64 , inf64
C A request for a non-existing stream zone reports no zone.
	  ,xta , sreq
	  ,aox , z7777
	  ,*62 , 41b
	  ,atx , res
	  ,*64 , inf64
C After exit, stopping the former child by шифр must fail.
	  ,xta , pzc
	  ,*53 , 30b
	  ,atx , res
	  ,*64 , inf64
	  ,call, stop*
 mask:	  ,log , 2001
 b11:	  ,log , 2000 0000 0000
 pzc:	  ,oct , 2031 44
 exec2:	  ,log , 41
 evw:	  ,log , 2
 strq:	  ,log , 1030000
 z7777:	  ,log , 7777
 sreq:	  ,log , 0
 res:	  ,log , 0
 bufa:	  ,log , 0
	  ,log , 0
 inf64:	  ,    , res
	  ,    , res
	 2,    , 20b
	 8,    ,
 infb:	  ,    , bufa
	  ,    , bufa
	 2,    , 20b
	 8,    ,
 cwrd:	  ,oct , 1442 5055
 deck:	  ,gost, 30hшифр 419900 зс5'115'лен 41(2048)'115'
	  ,gost, 6hеев1а3
	  ,gost, 18h'341'*name pz'341'*no list
	  ,gost, 12h'341'*assembler
	  ,gost, 18h'341' program: ,name,
	  ,gost, 18h'341'  ,xta , mast
	  ,gost, 18h'341'  ,*53 , 46b
	  ,gost, 18h'341'  ,call, stop*
	  ,gost, 30h'341' mast:  ,oct , 2031 4631
	  ,gost, 12h'341'  ,end ,
	  ,gost, 12h'341'*execute
	  ,gost, 12h'341'*end file '341'
	  ,gost, 6h'342''342''342''342''342''342'
